# LANZAR AI — Hosted AI Inference Configuration (Example)
# Add your OpenAI-compatible hosted provider credentials below.
# Supported endpoints: Groq (https://api.groq.com/openai/v1), OpenRouter (https://openrouter.ai/api/v1), etc.

HOSTED_AI_API_KEY=your_hosted_ai_api_key_here
